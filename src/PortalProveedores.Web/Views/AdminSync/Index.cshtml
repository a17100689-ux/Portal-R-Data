@model PortalProveedores.Application.DTOs.EstadoSincronizacionResumenDto
@{
    ViewData["Title"] = "Centro de Sincronización ERP Central";
}

<div class="container py-4">
    <!-- Breadcrumb y Título -->
    <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between mb-4 pb-2 border-bottom">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small text-muted">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-secondary">Inicio</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Sincronización Central</li>
                </ol>
            </nav>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-dark text-warning px-2 py-1 small rounded-1 fw-bold">PUENTE ERP</span>
                <h3 class="fw-bold mb-0 text-dark">Centro de Sincronización</h3>
            </div>
            <p class="text-muted small mb-0 mt-1">
                Monitoreo y despacho transaccional entre <code>PortalProveedores_DB</code> y <code>Punto_de_Venta</code>.
            </p>
        </div>
        <div class="mt-3 mt-md-0 d-flex gap-2">
            <a asp-controller="Auth" asp-action="Registro" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                <i class="bi bi-person-plus me-1"></i> Alta Proveedores
            </a>
            <a asp-controller="Facturas" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                <i class="bi bi-receipt me-1"></i> Facturas
            </a>
        </div>
    </div>

    <!-- Mensajes de Alerta -->
    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm py-2 px-3 small d-flex align-items-center" role="alert">
            <i class="bi bi-check-circle-fill text-success fs-5 me-2 flex-shrink-0"></i>
            <div class="flex-grow-1">@TempData["MensajeExito"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["MensajeError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm py-2 px-3 small d-flex align-items-center" role="alert">
            <i class="bi bi-exclamation-triangle-fill text-danger fs-5 me-2 flex-shrink-0"></i>
            <div class="flex-grow-1">@TempData["MensajeError"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["MensajeInfo"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show rounded-3 shadow-sm py-2 px-3 small d-flex align-items-center" role="alert">
            <i class="bi bi-info-circle-fill text-info fs-5 me-2 flex-shrink-0"></i>
            <div class="flex-grow-1">@TempData["MensajeInfo"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Tarjetas de Métricas de la Cola -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card card-custom p-3 border-start border-4 border-warning shadow-sm h-100">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small fw-bold">PENDIENTES EN COLA</span>
                    <i class="bi bi-clock-history text-warning fs-5"></i>
                </div>
                <h2 class="fw-bold mb-0 text-dark">@Model.FacturasPendientes</h2>
                <small class="text-muted">Esperando inserción en ERP</small>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card card-custom p-3 border-start border-4 border-primary shadow-sm h-100">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small fw-bold">EN PROCESO</span>
                    <i class="bi bi-arrow-repeat text-primary fs-5"></i>
                </div>
                <h2 class="fw-bold mb-0 text-dark">@Model.FacturasEnProceso</h2>
                <small class="text-muted">Tomadas por el worker</small>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card card-custom p-3 border-start border-4 border-success shadow-sm h-100">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small fw-bold">SINCRONIZADAS OK</span>
                    <i class="bi bi-check2-circle text-success fs-5"></i>
                </div>
                <h2 class="fw-bold mb-0 text-dark">@Model.FacturasCompletadas</h2>
                <small class="text-muted">Con número de documento ERP</small>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card card-custom p-3 border-start border-4 border-danger shadow-sm h-100">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small fw-bold">FALLIDAS / ERROR</span>
                    <i class="bi bi-shield-x text-danger fs-5"></i>
                </div>
                <h2 class="fw-bold mb-0 text-dark">@Model.FacturasFallidas</h2>
                <small class="text-muted">Excedieron límite de reintentos</small>
            </div>
        </div>
    </div>

    <!-- Acciones Manuales y Estado del Worker -->
    <div class="row g-4 mb-4">
        <!-- Columna Izquierda: Acciones de Sincronización Manual -->
        <div class="col-12 col-lg-7">
            <div class="card card-custom p-4 shadow-sm h-100">
                <div class="d-flex align-items-center gap-2 pb-2 mb-3 border-bottom">
                    <i class="bi bi-lightning-charge-fill text-warning fs-5"></i>
                    <h5 class="fw-bold mb-0 text-dark">Acciones de Sincronización Inmediata</h5>
                </div>
                <p class="text-muted small mb-4">
                    El servicio en segundo plano (Worker) ejecuta estas tareas automáticamente. Sin embargo, puede forzar la ejecución bajo demanda:
                </p>

                <div class="d-flex flex-column gap-3">
                    <!-- Acción 1: Procesar facturas en cola -->
                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center p-3 rounded-3 bg-light border">
                        <div>
                            <div class="fw-bold text-dark mb-1">
                                <i class="bi bi-send-fill text-primary me-1"></i> Despachar Cola de Facturas
                            </div>
                            <small class="text-muted">Transfiere facturas pendientes hacia <code>Compras_Y_Devoluciones</code>.</small>
                        </div>
                        <form asp-action="ProcesarCola" method="post" class="mt-2 mt-sm-0 flex-shrink-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm">
                                <i class="bi bi-play-fill me-1"></i> Sincronizar Ahora
                            </button>
                        </form>
                    </div>

                    <!-- Acción 2: Refrescar Catálogos -->
                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center p-3 rounded-3 bg-light border">
                        <div>
                            <div class="fw-bold text-dark mb-1">
                                <i class="bi bi-arrow-repeat text-success me-1"></i> Refrescar Catálogos Centrales
                            </div>
                            <small class="text-muted">Actualiza proveedores (con CP y Teléfono), sucursales y artículos desde el ERP.</small>
                        </div>
                        <form asp-action="RefrescarCatalogos" method="post" class="mt-2 mt-sm-0 flex-shrink-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-success btn-sm rounded-pill px-3 shadow-sm">
                                <i class="bi bi-cloud-download me-1"></i> Refrescar Catálogos
                            </button>
                        </form>
                    </div>

                    <!-- Acción 3: Verificar Recepción de Mercancía -->
                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center p-3 rounded-3 bg-light border">
                        <div>
                            <div class="fw-bold text-dark mb-1">
                                <i class="bi bi-box-seam-fill text-warning me-1"></i> Verificar Entrega de Mercancía
                            </div>
                            <small class="text-muted">Coteja con <code>Compras_Y_Devoluciones.Fecha_De_Recepcion</code> en el ERP.</small>
                        </div>
                        <form asp-action="VerificarEntregas" method="post" class="mt-2 mt-sm-0 flex-shrink-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-warning btn-sm rounded-pill px-3 shadow-sm text-dark fw-semibold">
                                <i class="bi bi-check-all me-1"></i> Verificar Entregas
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Columna Derecha: Estado de los Servicios -->
        <div class="col-12 col-lg-5">
            <div class="card card-custom p-4 shadow-sm h-100">
                <div class="d-flex align-items-center gap-2 pb-2 mb-3 border-bottom">
                    <i class="bi bi-hdd-network-fill text-primary fs-5"></i>
                    <h5 class="fw-bold mb-0 text-dark">Estado del Puente</h5>
                </div>

                <ul class="list-group list-group-flush small mb-3">
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                        <span class="text-muted">Servicio en segundo plano (Worker):</span>
                        <span class="badge bg-success-subtle text-success fw-bold">Activo / Operando</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                        <span class="text-muted">Frecuencia de cola de facturas:</span>
                        <span class="fw-bold text-dark font-monospace">Cada 30 seg</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                        <span class="text-muted">Frecuencia de recepción mercancía:</span>
                        <span class="fw-bold text-dark font-monospace">Cada 5 min</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                        <span class="text-muted">Frecuencia de refresco catálogos:</span>
                        <span class="fw-bold text-dark font-monospace">Cada 1 hora</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                        <span class="text-muted">Última sincronización exitosa:</span>
                        <span class="fw-bold text-dark">
                            @(Model.UltimaSincronizacionExitosa?.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") ?? "Sin registros")
                        </span>
                    </li>
                </ul>

                <div class="alert alert-light border rounded-3 p-3 small mb-0">
                    <div class="fw-bold text-dark mb-1">
                        <i class="bi bi-shield-check text-success me-1"></i> Garantía Transaccional Outbox:
                    </div>
                    <p class="text-muted mb-0" style="font-size: 0.82rem;">
                        Las facturas ingresadas por proveedores se validan y guardan localmente en milisegundos. El motor garantiza que ningún registro se pierda, incluso ante caídas temporales del servidor ERP central.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
