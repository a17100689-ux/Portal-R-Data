@{
    ViewData["Title"] = "Acceso Denegado";
}

<div class="row justify-content-center pt-5">
    <div class="col-md-6 text-center">
        <div class="card card-custom p-5 bg-white">
            <div class="text-danger mb-3">
                <i class="bi bi-shield-x" style="font-size: 4rem;"></i>
            </div>
            <h3 class="fw-bold">Acceso No Autorizado</h3>
            <p class="text-muted mt-2">
                No cuentas con los privilegios suficientes para consultar este recurso.
            </p>
            <div class="mt-4">
                <a asp-controller="Facturas" asp-action="Index" class="btn btn-primary rounded-pill px-4">
                    <i class="bi bi-house-door me-1"></i> Ir al Inicio
                </a>
            </div>
        </div>
    </div>
</div>
