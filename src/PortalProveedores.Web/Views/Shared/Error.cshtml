@model PortalProveedores.Web.Models.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="row justify-content-center pt-4">
    <div class="col-md-7 text-center">
        <div class="card card-custom p-5 bg-white">
            <div class="text-danger mb-3">
                <i class="bi bi-exclamation-triangle" style="font-size: 3.5rem;"></i>
            </div>
            <h3 class="fw-bold">Ha ocurrido un problema</h3>
            <p class="text-muted mt-2">
                No fue posible completar su solicitud en este momento. El incidente ha sido registrado de forma segura para su análisis por el equipo de soporte.
            </p>

            @if (!string.IsNullOrEmpty(Model.TicketId))
            {
                <div class="alert alert-light border d-inline-block px-4 py-2 my-3">
                    <span class="text-secondary small">Folio de Ticket de Soporte:</span>
                    <div class="fw-bold font-monospace text-primary">@Model.TicketId</div>
                </div>
            }

            <div class="mt-3">
                <a asp-controller="Facturas" asp-action="Index" class="btn btn-primary rounded-pill px-4">
                    <i class="bi bi-arrow-clockwise me-1"></i> Volver a Intentar
                </a>
            </div>
        </div>
    </div>
</div>
