<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Radial Llantas | Portal de Proveedores</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg radial-navbar shadow-sm py-2">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center py-1" asp-area="" asp-controller="Facturas" asp-action="Index">
                    <img src="~/images/radial-llantas-logo.svg" alt="Radial Llantas México" class="radial-logo-img me-2" />
                    <span class="badge-radial-yellow d-none d-sm-inline-block">PROVEEDORES R-DATA</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                        aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-4">
                            <li class="nav-item">
                                <a class="nav-link fw-medium text-dark" asp-controller="Facturas" asp-action="Index">
                                    <i class="bi bi-file-earmark-spreadsheet me-1"></i> Mis Facturas
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link fw-medium text-dark" asp-controller="Facturas" asp-action="Cargar">
                                    <i class="bi bi-cloud-arrow-up me-1"></i> Cargar Factura
                                </a>
                            </li>
                            @if (User.IsInRole("Administrador") || User.IsInRole("Admin") || User.HasClaim("EsAdmin", "true"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link fw-bold text-dark d-flex align-items-center" asp-controller="Auth" asp-action="Registro">
                                        <i class="bi bi-person-plus-fill text-warning me-1"></i> Registro de Proveedores
                                        <span class="badge bg-dark text-warning ms-1" style="font-size: 0.65rem;">ADMIN</span>
                                    </a>
                                </li>
                            }
                        </ul>
                        <div class="d-flex align-items-center gap-3">
                            <span class="text-secondary small">
                                <i class="bi bi-person-circle me-1"></i>
                                <strong>@User.Identity.Name</strong>
                            </span>
                            <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                                    <i class="bi bi-box-arrow-right me-1"></i> Salir
                                </button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <ul class="navbar-nav ms-auto align-items-center">
                            <li class="nav-item me-3 d-none d-lg-block">
                                <span class="small text-muted">
                                    <i class="bi bi-telephone me-1"></i> xxxxxxxxxx
                                </span>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="@(ViewData["FullWidthLayout"] != null && (bool)ViewData["FullWidthLayout"]! ? "container-fluid px-3 px-lg-5" : "container") main-container py-4">
        @if (TempData["MensajeExito"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["MensajeExito"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["MensajeError"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["MensajeError"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="radial-footer">
        <div class="container">
            <div class="row align-items-center gy-3">
                <div class="col-md-6 text-center text-md-start">
                    <span class="fw-semibold text-dark">&copy; @DateTime.UtcNow.Year Radial Llantas México.</span>
                    <span class="text-muted d-block d-sm-inline ms-sm-1">Portal R-Data para Proveedores Autorizados.</span>
                </div>
                <div class="col-md-6 text-center text-md-end small">
                    <span class="me-3 text-muted"><i class="bi bi-shield-check text-success me-1"></i> CFDI 4.0 Seguro</span>
                    <a href="https://radialllantas.com/policies/privacy-policy" target="_blank" rel="noopener noreferrer" class="text-decoration-none text-secondary me-3">Privacidad</a>
                    <a href="https://radialllantas.com/policies/refund-policy" target="_blank" rel="noopener noreferrer" class="text-decoration-none text-secondary">Términos</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
